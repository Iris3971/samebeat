# 在服务器上复制为 .env 并填入。两个值必须不同，都用：openssl rand -hex 32
# /ingest 与 /state 的 Bearer token
SAMEBEAT_TOKEN=
# MCP 秘密路径 /mcp/<这个值>；轮换：换新值后 docker compose up -d，再更新 Connector 网址
SAMEBEAT_MCP_SECRET=
# 用户时区（IANA 名称），长期换地区时只改这里
SAMEBEAT_USER_TIMEZONE=Asia/Shanghai

# 公网域名，不含协议或路径；留空仅允许本机 MCP 请求
SAMEBEAT_PUBLIC_HOSTS=samebeat.example.com
